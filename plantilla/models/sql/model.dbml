Table roles {
    id int [pk, increment]
    nombre varchar(50) [not null, unique]
    descripcion text
}

Table permisos {
    id int [pk, increment]
    nombre varchar(50) [not null, unique]
    descripcion text
}

Table rol_permisos {
    id int [pk, increment]
    rol_id int [not null]
    permiso_id int [not null]
    indexes {
        (rol_id, permiso_id) [unique]
    }
}

Table usuarios {
    id int [pk, increment]
    username varchar(50) [not null, unique]
    email varchar(100) [not null, unique]
    password varchar(255) [not null]
    nombre_completo varchar(100)
    fecha_registro timestamp [default: `CURRENT_TIMESTAMP`]
    estado enum('inactivo', 'activo') [default: 'inactivo']
    telefono varchar(20)
    direccion text
    fecha_nacimiento date
    avatar varchar(255)
    rol_id int
    ejecutables varchar(20)
}

Table menu_opciones {
    id int [pk, increment]
    nombre varchar(100) [not null]
    ruta varchar(255) [not null]
    icono varchar(255)
    estado enum('activo', 'inactivo') [default: 'activo']
}

Table usuario_menu_opciones {
    id int [pk, increment]
    usuario_id int [not null]
    menu_opcion_id int [not null]
}

Table categorias {
    id int [pk, increment]
    nombre varchar(100) [not null, unique]
    descripcion text
}

Table aplicaciones {
    id int [pk, increment]
    nombre varchar(100) [not null]
    descripcion text
    precio decimal(10, 2) [not null]
    stock int [not null]
    imagen_url varchar(255)
    categoria_id int
    estado enum('disponible', 'no_disponible') [default: 'disponible']
}

Table carrito {
    id int [pk, increment]
    usuario_id int [not null]
    fecha_creacion timestamp [default: `CURRENT_TIMESTAMP`]
    estado enum('pendiente', 'completado', 'cancelado') [default: 'pendiente']
}

Table carrito_aplicaciones {
    id int [pk, increment]
    carrito_id int [not null]
    aplicacion_id int [not null]
    cantidad int [not null]
    precio_total decimal(10, 2) [not null]
}

Table historial_transacciones {
    id int [pk, increment]
    carrito_id int [not null]
    usuario_id int [not null]
    fecha timestamp [default: `CURRENT_TIMESTAMP`]
    total decimal(10, 2) [not null]
}

Ref: usuarios.rol_id > roles.id
Ref: rol_permisos.rol_id > roles.id
Ref: rol_permisos.permiso_id > permisos.id
Ref: usuario_menu_opciones.usuario_id > usuarios.id
Ref: usuario_menu_opciones.menu_opcion_id > menu_opciones.id
Ref: aplicaciones.categoria_id > categorias.id
Ref: carrito.usuario_id > usuarios.id
Ref: carrito_aplicaciones.carrito_id > carrito.id
Ref: carrito_aplicaciones.aplicacion_id > aplicaciones.id
Ref: historial_transacciones.carrito_id > carrito.id
Ref: historial_transacciones.usuario_id > usuarios.id

